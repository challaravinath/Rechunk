<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The XML file ships in the package. A public member with no comment is still allowed. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- the build on GitHub Actions gets reproducible paths -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- package metadata, source link and symbols. Each project sets its own PackageId and Description. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>Challa Ravindranath</Authors>
    <Copyright>Copyright (c) 2026 Challa Ravindranath</Copyright>
    <Description>Chunk deduplication for RAG pipelines in .NET.</Description>
    <RepositoryUrl>https://github.com/challaravinath/Rechunk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/challaravinath/Rechunk</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>rag;dedup;embeddings;simhash;minhash;lsh;semantic-kernel</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
