<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Rechunk</AssemblyName>
    <RootNamespace>Rechunk</RootNamespace>
    <PackageId>Rechunk</PackageId>
    <Description>Dedup and revision aware ingestion for RAG pipelines in .NET. Exact hash, SimHash and MinHash, plus revisions, audit and erasure.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
